{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "west twister -c --disable-warnings-as-errors -O ./twister-out -T ./tests",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Run all rt_core test suites using twister",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "west twister -c --disable-warnings-as-errors -O ./twister-out -T ./tests/unit",
            "group": "test",
            "detail": "Run the rt_core unit test suites using twister",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Functional Tests",
            "type": "shell",
            "command": "west twister -c --disable-warnings-as-errors -O ./twister-out -T ./tests/functional",
            "group": "test",
            "detail": "Run the rt_core functional test suites using twister",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean Twister Output",
            "type": "shell",
            "command": "rm -rf ./twister-out ./build",
            "group": "none",
            "detail": "Clean up the twister and build output directories"
        },
        {
            "label": "Format: check",
            "type": "shell",
            "command": "scripts/format.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "detail": "List files that differ from the clang-format style"
        },
        {
            "label": "Format: check changed",
            "type": "shell",
            "command": "scripts/format.sh --changed",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "detail": "Check only the files changed since the merge base with origin/main"
        },
        {
            "label": "Format: fix",
            "type": "shell",
            "command": "scripts/format.sh --fix",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "detail": "Reformat the sources in place with clang-format"
        }
    ]
}
