menu "EerieLeap Core Module"

config EERIE_LEAP_RT_CORE
    bool "EerieLeap Common Module"
    help
      Add EerieLeap common code.

config EERIE_LEAP_BLUETOOTH
    bool "EerieLeap Bluetooth"
    depends on BT
    select EERIE_LEAP_THREADING
    help
      Add EerieLeap Bluetooth.

config EERIE_LEAP_CFB
    bool "EerieLeap CFB"
    help
      Add EerieLeap CFB.

config EERIE_LEAP_EVENT_BUS
    bool "EerieLeap Event Bus"
    select EERIE_LEAP_THREADING
    help
      Add EerieLeap Event Bus.

config EERIE_LEAP_LUA_SCRIPT
    bool "EerieLeap Lua Script"
    select LUA
    help
      Add EerieLeap Lua Script.

config EERIE_LEAP_LUA_SCRIPT_MEMORY_LIMIT_KB
    int "Memory limit of one Lua state in KiB (0 = unlimited)"
    depends on EERIE_LEAP_LUA_SCRIPT
    default 256
    help
      Allocations of a Lua state created on the external heap are counted and
      refused past this limit, so a script that leaks or allocates without bound
      fails its own call instead of exhausting the heap for the rest of the unit.

config EERIE_LEAP_EXPRESSION_ENGINE
    bool "EerieLeap Expression Engine"
    select EXPRESSION_ENGINE
    help
      Add the sensor expression evaluator, built on the EerieLeap expression
      engine module (modules/expression_engine).

config EERIE_LEAP_MDF
    bool "EerieLeap MDF"
    help
      Add EerieLeap MDF.

config EERIE_LEAP_RANDOM
    bool "EerieLeap Random"
    help
      Add EerieLeap Random.

config EERIE_LEAP_THREADING
    bool "EerieLeap Threading"
    help
      Add EerieLeap Threading.

config EERIE_LEAP_TIME
    bool "EerieLeap Time"
    help
      Add EerieLeap Time.

config EERIE_LEAP_DOMAIN_BLE
    depends on EERIE_LEAP_BLUETOOTH && EERIE_LEAP_DOMAIN_SENSOR && EERIE_LEAP_DOMAIN_SYSTEM
    select EERIE_LEAP_SMP_BLE
    bool "EerieLeap BLE Domain"
    help
      Add EerieLeap BLE Domain.

config EERIE_LEAP_DOMAIN_CANBUS
    depends on EERIE_LEAP_CONFIGURATION && EERIE_LEAP_CANBUS
    bool "EerieLeap CANBus Domain"
    help
      Add EerieLeap CANBus Domain.

config EERIE_LEAP_DOMAIN_SCRIPT
    bool "EerieLeap Script Domain"
    help
      Add EerieLeap Script Domain.

module = EERIE_LEAP_RT_CORE
module-str = eerie_leap_rt_core

source "subsys/logging/Kconfig.template.log_config"

rsource "src/configuration/Kconfig.configuration"
rsource "src/subsys/adc/Kconfig.adc"
rsource "src/subsys/assets/Kconfig.assets"
rsource "src/subsys/canbus/Kconfig.canbus"
rsource "src/subsys/cdmp/Kconfig.cdmp"
rsource "src/subsys/device_tree/Kconfig.device_tree"
rsource "src/subsys/fs/Kconfig.fs"
rsource "src/subsys/gpio/Kconfig.gpio"
rsource "src/subsys/smp/Kconfig.smp"

rsource "src/domain/system_domain/Kconfig.system_domain"
rsource "src/domain/canbus_com_domain/Kconfig.canbus_com_domain"
rsource "src/domain/sensor_domain/Kconfig.sensor_domain"
rsource "src/domain/logging_domain/Kconfig.logging_domain"

rsource "src/controllers/Kconfig.controllers"
endmenu
