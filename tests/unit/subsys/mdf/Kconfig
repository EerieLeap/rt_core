config EERIE_LEAP_FS_SD_THREAD_STACK_SIZE
	int "SD thread stack size"
	default 2048

config EERIE_LEAP_SD_CHECK_INTERVAL_MS
	int "SD check interval ms"
	default 1000

config MDF_TEST_DUMP_DIR
	string "Host directory the mdf_file suite writes a complete file into (empty: skipped)"
	default ""
	depends on ARCH_POSIX
	help
	  Only native_sim reaches the host file system: it links the host libc, so std::ofstream
	  writes there. Other platforms do not link std::ofstream at all.
