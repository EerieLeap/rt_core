config LOGGING_UNIT_TEST_DUMP_DIR
	string "Host directory the mdf4_logger suite writes its CAN file into (empty: not written)"
	default ""
	depends on ARCH_POSIX
	help
	  Only native_sim reaches the host file system: it links the host libc, so std::ofstream
	  writes there. Other platforms do not link std::ofstream at all.
