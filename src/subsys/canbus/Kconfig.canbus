config EERIE_LEAP_CANBUS
    bool "EerieLeap CANBus"
    depends on CAN
    help
      Add EerieLeap CANBus.

menu "EerieLeap CANBus config"
    depends on EERIE_LEAP_CANBUS

    config EERIE_LEAP_CANBUS_AUTO_DETECT_INTERVAL_MS
        int "Canbus auto detect activity check interval ms"
        default 5000

    config EERIE_LEAP_CANBUS_RX_QUEUE_SIZE
        int "Canbus receive queue depth in frames"
        default 32
        range 1 1024
        help
          Number of received frames buffered between the RX callback and the
          bottom half thread. Frames arriving on a full queue are dropped and
          counted by Canbus::GetRxDroppedCount().

    config EERIE_LEAP_CAN_MONITOR_TX_SLOTS
        int "Frames in flight the CAN monitor's echo can follow"
        default 16
        range 1 64
        help
          Frames in flight the CAN monitor's echo can follow. While a tap is set, each
          frame the unit sends takes a slot from a pool of this size until the controller
          completes it, so the tap sees it as a transmitted frame. A frame sent with no
          free slot goes out as usual but has no echo, and is counted by
          Canbus::GetTxEchoLostCount(). The pool is allocated at the first
          Canbus::SetTap(), and costs about 80 bytes a slot.

    module = EERIE_LEAP_CANBUS
    module-str = eerie_leap_canbus
    source "subsys/logging/Kconfig.template.log_config"
endmenu
