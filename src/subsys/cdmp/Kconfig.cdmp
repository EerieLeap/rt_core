config EERIE_LEAP_CDMP
    bool "EerieLeap CDMP"
    select CRC
    select HWINFO
    select EERIE_LEAP_RANDOM
    help
      Add EerieLeap CDMP.

menu "EerieLeap CDMP config"
    depends on EERIE_LEAP_CDMP

    config EERIE_LEAP_CDMP_SERVICE_THREAD_PRIORITY
        int "EerieLeap CDMP Service Thread Priority"
        default 5
        help
          Add EerieLeap CDMP Service Thread Priority.

    config EERIE_LEAP_CDMP_SERVICE_THREAD_STACK_SIZE
        int "EerieLeap CDMP Service Thread Stack Size"
        default 4096
        help
          Add EerieLeap CDMP Service Thread Stack Size.

    config EERIE_LEAP_CDMP_WORK_QUEUE_PRIORITY
        int "EerieLeap CDMP Work Queue Priority"
        default 5
        help
          Add EerieLeap CDMP Work Queue Priority.

    config EERIE_LEAP_CDMP_WORK_QUEUE_STACK_SIZE
        int "EerieLeap CDMP Work Queue Stack Size"
        default 4096
        help
          Add EerieLeap CDMP Work Queue Stack Size.

    config EERIE_LEAP_CDMP_CMD_TRANSACTION_TIMEOUT_MS
        int "EerieLeap CDMP Command Transaction Timeout"
        default 500
        help
          Add EerieLeap CDMP Command Transaction Timeout.

    config EERIE_LEAP_CDMP_STATE_MAX_LOCAL_RECORDS
        int "Shared state records of this unit"
        default 8
        range 1 32
        help
          State types this unit can share at once. A withdrawn record keeps its
          slot until every online peer has acknowledged the withdrawal, unless a
          new type needs the slot first.

    config EERIE_LEAP_CDMP_STATE_MAX_REMOTE_RECORDS
        int "Shared state records of other units"
        default 32
        range 1 1024
        help
          Records of other units this unit keeps, about 10 bytes each. The
          records of a source that do not fit are dropped, and that source's
          heartbeat digest is not checked until room frees up.
endmenu
