; The logging triggers of a unit (ConfigurationService type 8). Every field is required.
CborLoggingControlConfig = [
    triggers: [0*16 CborLoggingControlBindingConfig]
]

; An event binding whose value, read as a bool, is the wanted logging state. The fields are those
; of the UI's CborPropertyBinding without its UI-only ones (target, direction, outbound_event_type).
CborLoggingControlBindingConfig = [
    channel: uint,                          ; EventChannelId: 1 sensors, 2 logging, ...
    event_type: uint,                       ; the channel's event type
    payload_key: uint,                      ; the channel's payload key whose value is read
    has_selector: bool,
    selector_key: uint,                     ; the payload key the selector matches
    selector_value: CborSelectorValueType,  ; ignored without a selector; written as 0
    target_uid: uint                        ; CDMP UID of the unit to start and stop, 0 = every unit that can log
]

; Text matches its hash, as payloads carry text ids. An integer may be written in the uint32 range
; (a hash above 2^31-1 as is) or negative; the unit keeps the same 32 bits either way.
CborSelectorValueType = CborSelectorInteger / tstr / bool
CborSelectorInteger = -2147483648..4294967295
