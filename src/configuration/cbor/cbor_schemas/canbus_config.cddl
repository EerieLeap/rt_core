CborCanSignalConfig = [
  start_bit: uint,
  size_bits: uint,
  factor: float32,
  offset: float32,
  byte_order: uint,
  is_signed: bool,
  name: tstr,
  unit: tstr
]

CborCanMessageConfig = [
  frame_id: uint,
  send_interval_ms: int,
  script_path: tstr,

  name: tstr,
  message_size: uint,
  signal_configs: [*CborCanSignalConfig]
]

CborCanChannelConfig = [
  type: uint,
  is_extended_id: bool,
  bus_channel: uint,
  bitrate: uint,
  data_bitrate: uint,
  message_configs: [*CborCanMessageConfig]
]

CborCanbusComConfig = [
  bus_channel: int,
  cdmp_base_can_id: uint,
  smp_can_id_base: uint,
  smp_bus_share_percent: uint
]

CborCanbusConfig = [
  channel_configs: [0*8 CborCanChannelConfig],
  com_config: CborCanbusComConfig
]
