config EERIE_LEAP_DOMAIN_SYSTEM
    depends on EERIE_LEAP_CONFIGURATION
    bool "EerieLeap System Domain"
    help
      Add EerieLeap System Domain.

menu "EerieLeap System Domain config"
    depends on EERIE_LEAP_DOMAIN_SYSTEM

    config EERIE_LEAP_PRODUCT_ID
        int "Product ID (16-bit)"
        range 0 65535
        default 0

    config EERIE_LEAP_REVISION
        int "Revision (8-bit)"
        range 0 255
        default 0

    config EERIE_LEAP_HW_VERSION_MAJOR
        int "Hardware version major (8-bit)"
        range 0 255
        default 0

    config EERIE_LEAP_HW_VERSION_MINOR
        int "Hardware version minor (8-bit)"
        range 0 255
        default 0

    config EERIE_LEAP_HW_VERSION_PATCH
        int "Hardware version patch (16-bit)"
        range 0 65535
        default 0

    config EERIE_LEAP_SW_VERSION_MAJOR
        int "Software version major (8-bit)"
        range 0 255
        default 0

    config EERIE_LEAP_SW_VERSION_MINOR
        int "Software version minor (8-bit)"
        range 0 255
        default 0

    config EERIE_LEAP_SW_VERSION_PATCH
        int "Software version patch (16-bit)"
        range 0 65535
        default 0

endmenu

menu "EerieLeap unit features"

    # The 16-bit ProductFeature mask a unit reports (SMP device group, BLE advertisement, CDMP).
    # Each follows the domains the build contains; a board can turn one off. DISPLAY, and STORAGE on a
    # unit that does not log, are set by hand.
    config EERIE_LEAP_FEATURES_ANALOG_INPUTS
        bool "Analog inputs feature"
        default y if EERIE_LEAP_CONTROLLER_ADC
    config EERIE_LEAP_FEATURES_DIGITAL_INPUTS
        bool "Digital inputs feature"
        default y if EERIE_LEAP_DOMAIN_SENSOR && EERIE_LEAP_GPIO
    config EERIE_LEAP_FEATURES_CANBUS
        bool "CANBus feature"
        default y if EERIE_LEAP_DOMAIN_CANBUS
    config EERIE_LEAP_FEATURES_LOGGING
        bool "Logging feature"
        default y if EERIE_LEAP_DOMAIN_LOGGING
        help
          A unit that can write logs. On CDMP the bit is sent only while a log writer is available.
    config EERIE_LEAP_FEATURES_BLUETOOTH
        bool "Bluetooth feature"
        default y if EERIE_LEAP_DOMAIN_BLE
    config EERIE_LEAP_FEATURES_DISPLAY
        bool "Display feature"
        default n
    config EERIE_LEAP_FEATURES_STORAGE
        bool "Storage feature"
        default y if EERIE_LEAP_DOMAIN_LOGGING
        help
          A unit with an SD service: it runs the Lua scripts a script_path names and its SMP files
          group lists the card. Not whether a card is mounted, which the files group reports. A unit
          that logs writes to the card, so it has one; another unit with an SD service sets it by hand.

endmenu
