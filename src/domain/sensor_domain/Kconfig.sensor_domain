config EERIE_LEAP_DOMAIN_SENSOR
    depends on EERIE_LEAP_CONFIGURATION && EERIE_LEAP_ADC
    bool "EerieLeap Sensor Domain"
    # The pipeline builder registers the Lua sensor functions of the script domain.
    select EERIE_LEAP_DOMAIN_SCRIPT
    # Analog readers take their calibration from the ADC domain's configuration.
    select EERIE_LEAP_DOMAIN_ADC
    help
      Add EerieLeap Sensor Domain.

menu "EerieLeap Sensor Domain config"
    depends on EERIE_LEAP_DOMAIN_SENSOR

    config EERIE_LEAP_DOMAIN_SENSOR_PROCESSING_SERVICE_STACK_SIZE
        int "Sensor processing service stack size"
        default 8192

    config EERIE_LEAP_DOMAIN_SENSOR_PROCESSING_SERVICE_PRIORITY
        int "Sensor processing service priority"
        default 6

    config EERIE_LEAP_DOMAIN_SENSOR_PROCESSING_STATS
        bool "Log rate group statistics"
        help
          Logs one line per rate group every
          EERIE_LEAP_DOMAIN_SENSOR_PROCESSING_STATS_LOG_PERIOD_S seconds: ticks,
          overruns, the last and longest tick, and the delivered period between
          tick starts (average, minimum and maximum since the previous line,
          from the cycle counter), followed by the latest result of each ADC
          channel the group samples, named by its global channel index
          ("ch0 0.898 V ch1 0.000 V"). The tick and overrun counters are kept
          either way and read through GetRateGroupStats(); this adds the period
          measurement and the log. The log runs on the processing thread after
          the due groups, so its own time shows in the next line's period
          maximum. A measurement aid for the sampling path; off in production
          builds.

    config EERIE_LEAP_DOMAIN_SENSOR_PROCESSING_STATS_LOG_PERIOD_S
        int "Seconds between rate group statistics log lines"
        depends on EERIE_LEAP_DOMAIN_SENSOR_PROCESSING_STATS
        range 1 3600
        default 10

    config EERIE_LEAP_DOMAIN_SENSOR_EVENTS_PUBLISHER_PERIOD_MS
        int "Sensor events publisher period in ms"
        depends on EERIE_LEAP_EVENT_BUS
        range 1 10000
        default 30
        help
          Delay between two ticks of SensorEventsPublisher. A tick publishes
          the readings processed since the previous one on sensor_events; a
          sensor committed several times within one period is published once,
          with its latest value, so a pulse shorter than the period can be
          missed.

    config EERIE_LEAP_DOMAIN_SENSOR_EVENTS_PUBLISHER_STACK_SIZE
        int "Sensor events publisher stack size"
        depends on EERIE_LEAP_EVENT_BUS
        default 4096
        help
          Stack of the publisher's work queue. A tick also runs the filters of
          the sensor_events subscribers (Accepts()), once per sensor and
          subscription change. A filter that throws is caught there, but
          unwinding needs more stack than a tick: 4096 overflowed on
          qemu_cortex_a53.

    config EERIE_LEAP_DOMAIN_SENSOR_EVENTS_PUBLISHER_PRIORITY
        int "Sensor events publisher priority"
        depends on EERIE_LEAP_EVENT_BUS
        default 6

    config EERIE_LEAP_DOMAIN_SENSOR_MAX_COUNT
        int "Maximum number of configured sensors"
        range 1 65535
        default 64
        help
          A sensors configuration with more sensors is rejected at validation.
          Every sensor holds its readings and runtime objects in internal RAM,
          so size this for the unit's memory rather than for the configuration.

    config EERIE_LEAP_DOMAIN_SENSOR_RAW_CAN_QUEUE_SIZE
        int "Raw CAN frames queued for the log writer"
        range 1 1024
        default 32
        help
          Frames of CANBUS_RAW sensors are queued for the log writer so every
          frame is logged, not only the latest one at each logging tick. Frames
          arriving while the queue is full are dropped and counted. Each entry
          takes about 90 bytes of internal RAM; the queue only exists while an
          enabled CANBUS_RAW sensor is configured.
endmenu
