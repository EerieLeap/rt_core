config EERIE_LEAP_DOMAIN_ADC
    depends on EERIE_LEAP_ADC && EERIE_LEAP_CONFIGURATION
    bool "EerieLeap ADC Domain"
    help
      Add EerieLeap ADC Domain: the user's ADC configuration (samples and
      a calibration per channel), its validation and storage.

menu "EerieLeap ADC Domain config"
    depends on EERIE_LEAP_DOMAIN_ADC

    config EERIE_LEAP_ADC_VOLTAGE_MAX_MV
        int "ADC voltage max"
        range 1 100000
        default 3100
        help
          ADC pin voltage that corresponds to
          EERIE_LEAP_SENSOR_VOLTAGE_MAX_MV at the sensor input.

    config EERIE_LEAP_SENSOR_VOLTAGE_MAX_MV
        int "Sensor voltage max"
        range 1 100000
        default 5000

    config EERIE_LEAP_ADC_CALIBRATION_SAMPLES_COUNT
        int "ADC calibration samples count"
        range 1 65535
        default 2048
        help
          Conversions averaged per calibration reading; at most
          EERIE_LEAP_ADC_SAMPLES_MAX.

    config EERIE_LEAP_ADC_CALIBRATION_SAMPLING_RATE_MS
        int "ADC calibration sampling rate ms"
        default 100
endmenu
